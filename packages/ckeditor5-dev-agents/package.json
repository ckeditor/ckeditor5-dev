{
  "name": "@ckeditor/ckeditor5-dev-agents",
  "version": "63.0.0",
  "description": "A framework for running recurring AI agent tasks and reporting the results as pull requests.",
  "keywords": [],
  "author": "CKSource (http://cksource.com/)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ckeditor/ckeditor5-dev/tree/master/packages/ckeditor5-dev-agents",
  "bugs": "https://github.com/ckeditor/ckeditor5/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckeditor/ckeditor5-dev.git",
    "directory": "packages/ckeditor5-dev-agents"
  },
  "engines": {
    "node": ">=26.10.0",
    "npm": ">=5.7.1"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "ckeditor5-dev-agents": "bin/ckeditor5-dev-agents.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@octokit/rest": "^22.0.1",
    "entities": "^8.1.0",
    "simple-git": "^4.0.2",
    "upath": "^2.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "rolldown": "^1.2.6",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts --watch",
    "test": "vitest run --config ../../vitest.config.js --project ckeditor5-dev-agents"
  }
